# WinVinaya InfoSystems Website - Production Environment Variables
# Copy to backend/.env.prod

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wvis_prod
POSTGRES_USER=wvis_user
POSTGRES_PASSWORD=winvinaya12345

# Application Configuration
SECRET_KEY=your-super-secret-production-key-MUST-BE-CHANGED
ANALYTICS_SECRET_KEY=your-analytics-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production

# CORS Configuration
BACKEND_CORS_ORIGINS=["https://demo.winvinaya.com","https://www.demo.winvinaya.com"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
REDIS_URL=memory://

# Redis Configuration (OPTIONAL - not needed for local development)
# Rate limiting uses in-memory storage by default
# Uncomment these if you want to use Redis for production
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Admin User
FIRST_SUPERUSER=admin@winvinaya.com
FIRST_SUPERUSER_PASSWORD=your_strong_password_here

# Email Configuration - used for contact/demo request confirmation & notification emails
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=s.mail25.info
SMTP_USER=no-reply@winvinaya.com
SMTP_PASSWORD=Admin##2025@
EMAILS_FROM_EMAIL=no-reply@winvinaya.com
EMAILS_FROM_NAME=winvinaya
# Where new contact/demo form submissions are sent for the team's attention
CONTACT_NOTIFY_EMAIL=info@winvinaya.com

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png","doc","docx"]

# API Documentation
PROJECT_NAME="WinVinaya InfoSystems Website"

# Logging
LOG_LEVEL=INFO
